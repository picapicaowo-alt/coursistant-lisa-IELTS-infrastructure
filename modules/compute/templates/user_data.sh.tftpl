#!/usr/bin/env bash
set -euo pipefail

dnf install -y nginx jq tar gzip amazon-cloudwatch-agent

if ! id coursistant >/dev/null 2>&1; then
  useradd --system --create-home --shell /sbin/nologin coursistant
fi

install -d -o coursistant -g coursistant -m 0750 \
  /opt/coursistant/backend/releases \
  /opt/coursistant/frontend/releases \
  /opt/coursistant/shared
install -d -o root -g root -m 0755 /etc/coursistant

bootstrap_frontend=/opt/coursistant/frontend/releases/bootstrap
install -d -o coursistant -g coursistant -m 0750 "$bootstrap_frontend"
printf '%s\n' '<!doctype html><html lang="en"><meta charset="utf-8"><title>Coursistant test</title><body>Service deployment pending.</body></html>' > "$bootstrap_frontend/index.html"
chown coursistant:coursistant "$bootstrap_frontend/index.html"
ln -sfn "$bootstrap_frontend" /opt/coursistant/frontend/current

cat > /etc/coursistant/base.env <<'ENVIRONMENT'
AWS_REGION=${aws_region}
COURSISTANT_UPLOADS_BUCKET=${uploads_bucket}
COURSISTANT_ARTIFACTS_BUCKET=${artifacts_bucket}
AI_PROVIDER_MODE=${ai_provider_mode}
ENVIRONMENT
chmod 0644 /etc/coursistant/base.env

cat > /etc/coursistant/secret-arns.json <<'SECRETS'
${secret_arns_json}
SECRETS
chmod 0600 /etc/coursistant/secret-arns.json

cat > /usr/local/bin/coursistant-materialize-secrets <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

destination=/opt/coursistant/shared/runtime.env
temporary=$(mktemp /opt/coursistant/shared/runtime.env.XXXXXX)
trap 'rm -f "$temporary"' EXIT

install -o coursistant -g coursistant -m 0600 /etc/coursistant/base.env "$temporary"

while IFS= read -r secret_arn; do
  if ! secret_json=$(aws secretsmanager get-secret-value \
    --region '${aws_region}' \
    --secret-id "$secret_arn" \
    --query SecretString \
    --output text 2>/dev/null); then
    continue
  fi

  if ! jq -e 'type == "object"' >/dev/null <<<"$secret_json"; then
    echo "Secret $secret_arn must contain a JSON object" >&2
    exit 1
  fi

  if ! jq -e 'all(keys[]; test("^[A-Z][A-Z0-9_]*$"))' >/dev/null <<<"$secret_json"; then
    echo "Secret $secret_arn contains an invalid environment key" >&2
    exit 1
  fi

  jq -r 'to_entries[] | "\(.key)=\(.value | tostring | @json)"' <<<"$secret_json" >> "$temporary"
done < <(jq -r '.[]' /etc/coursistant/secret-arns.json)

chown coursistant:coursistant "$temporary"
chmod 0600 "$temporary"
mv -f "$temporary" "$destination"
trap - EXIT
SCRIPT
chmod 0750 /usr/local/bin/coursistant-materialize-secrets

cat > /etc/systemd/system/coursistant-backend.service <<'UNIT'
[Unit]
Description=Coursistant IELTS backend release
Wants=network-online.target
After=network-online.target
ConditionPathIsExecutable=/opt/coursistant/backend/current/bin/start

[Service]
Type=simple
User=coursistant
Group=coursistant
WorkingDirectory=/opt/coursistant/backend/current
EnvironmentFile=/opt/coursistant/shared/runtime.env
ExecStart=/opt/coursistant/backend/current/bin/start
ExecStop=-/opt/coursistant/backend/current/bin/stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/coursistant/shared /var/log/coursistant
StandardOutput=append:/var/log/coursistant/backend.log
StandardError=append:/var/log/coursistant/backend-error.log

[Install]
WantedBy=multi-user.target
UNIT

install -d -o coursistant -g coursistant -m 0750 /var/log/coursistant

cat > /usr/local/bin/coursistant-deploy-backend <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "Usage: coursistant-deploy-backend <s3-uri> <sha256> <release-id>" >&2
  exit 64
fi

s3_uri=$1
expected_sha=$2
release_id=$3

if [[ ! "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]]; then
  echo "Invalid release ID" >&2
  exit 65
fi

if [[ ! "$expected_sha" =~ ^[a-fA-F0-9]{64}$ ]]; then
  echo "Invalid SHA-256" >&2
  exit 65
fi

release_root=/opt/coursistant/backend
release_dir="$release_root/releases/$release_id"
archive=$(mktemp /tmp/coursistant-backend.XXXXXX.tgz)
previous_target=$(readlink -f "$release_root/current" 2>/dev/null || true)
trap 'rm -f "$archive"' EXIT

if [[ -e "$release_dir" ]]; then
  echo "Release already exists: $release_dir" >&2
  exit 66
fi

aws s3 cp --only-show-errors "$s3_uri" "$archive"
printf '%s  %s\n' "$expected_sha" "$archive" | sha256sum -c -

install -d -o coursistant -g coursistant -m 0750 "$release_dir"
tar --extract --gzip --file "$archive" --directory "$release_dir" --no-same-owner
chown -R coursistant:coursistant "$release_dir"

if [[ ! -x "$release_dir/bin/start" ]]; then
  echo "Release must contain executable bin/start" >&2
  rm -rf --one-file-system "$release_dir"
  exit 67
fi

if [[ -x "$release_dir/bin/preflight" ]]; then
  sudo -u coursistant "$release_dir/bin/preflight"
fi

/usr/local/bin/coursistant-materialize-secrets

if [[ -n "$previous_target" ]]; then
  ln -sfn "$previous_target" "$release_root/previous"
fi

rm -f "$release_root/current.next"
ln -s "$release_dir" "$release_root/current.next"
mv -Tf "$release_root/current.next" "$release_root/current"
systemctl daemon-reload
systemctl enable coursistant-backend.service
systemctl restart coursistant-backend.service

healthy=false
for _ in $(seq 1 30); do
  if [[ -x "$release_dir/bin/health" ]]; then
    if sudo -u coursistant "$release_dir/bin/health"; then
      healthy=true
      break
    fi
  elif curl --fail --silent --show-error --max-time 5 'http://127.0.0.1:${lms_api_port}/health' >/dev/null; then
    healthy=true
    break
  fi
  sleep 2
done

if [[ "$healthy" != true ]]; then
  echo "Release health check failed; rolling back" >&2
  if [[ -n "$previous_target" && -d "$previous_target" ]]; then
    ln -sfn "$previous_target" "$release_root/current"
    systemctl restart coursistant-backend.service
  else
    systemctl stop coursistant-backend.service || true
  fi
  exit 68
fi

find "$release_root/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
  | sort -nr \
  | awk 'NR > 5 { $1=""; sub(/^ /, ""); print }' \
  | while IFS= read -r old_release; do
      if [[ "$old_release" != "$(readlink -f "$release_root/current")" && "$old_release" != "$(readlink -f "$release_root/previous" 2>/dev/null || true)" ]]; then
        rm -rf --one-file-system "$old_release"
      fi
    done

systemctl enable --now coursistant-backend-health.timer
echo "Backend release active: $release_id"
SCRIPT
chmod 0750 /usr/local/bin/coursistant-deploy-backend

cat > /usr/local/bin/coursistant-rollback-backend <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

release_root=/opt/coursistant/backend
current_target=$(readlink -f "$release_root/current" 2>/dev/null || true)
previous_target=$(readlink -f "$release_root/previous" 2>/dev/null || true)

if [[ -z "$previous_target" || ! -d "$previous_target" ]]; then
  echo "No valid previous backend release" >&2
  exit 69
fi

ln -sfn "$previous_target" "$release_root/current"
if [[ -n "$current_target" && -d "$current_target" ]]; then
  ln -sfn "$current_target" "$release_root/previous"
fi
systemctl restart coursistant-backend.service
echo "Backend rolled back to: $previous_target"
SCRIPT
chmod 0750 /usr/local/bin/coursistant-rollback-backend

cat > /usr/local/bin/coursistant-backend-health <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

release_dir=$(readlink -f /opt/coursistant/backend/current 2>/dev/null || true)
[[ -n "$release_dir" && -d "$release_dir" ]] || exit 0

healthy=0
if [[ -x "$release_dir/bin/health" ]]; then
  if sudo -u coursistant "$release_dir/bin/health" >/dev/null 2>&1; then
    healthy=1
  fi
elif curl --fail --silent --max-time 5 'http://127.0.0.1:${lms_api_port}/health' >/dev/null; then
  healthy=1
fi

aws cloudwatch put-metric-data \
  --region '${aws_region}' \
  --namespace '${backend_health_metric_namespace}' \
  --metric-name BackendHealthy \
  --dimensions Name=Environment,Value='${backend_health_metric_environment}' \
  --value "$healthy" \
  --unit Count
SCRIPT
chmod 0750 /usr/local/bin/coursistant-backend-health

cat > /etc/systemd/system/coursistant-backend-health.service <<'UNIT'
[Unit]
Description=Publish Coursistant backend health metric
After=coursistant-backend.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/coursistant-backend-health
UNIT

cat > /etc/systemd/system/coursistant-backend-health.timer <<'UNIT'
[Unit]
Description=Check Coursistant backend health every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=coursistant-backend-health.service

[Install]
WantedBy=timers.target
UNIT

cat > /usr/local/bin/coursistant-deploy-frontend <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "Usage: coursistant-deploy-frontend <s3-uri> <sha256> <release-id>" >&2
  exit 64
fi

s3_uri=$1
expected_sha=$2
release_id=$3

if [[ ! "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || [[ ! "$expected_sha" =~ ^[a-fA-F0-9]{64}$ ]]; then
  echo "Invalid release ID or SHA-256" >&2
  exit 65
fi

release_root=/opt/coursistant/frontend
release_dir="$release_root/releases/$release_id"
archive=$(mktemp /tmp/coursistant-frontend.XXXXXX.tgz)
previous_target=$(readlink -f "$release_root/current" 2>/dev/null || true)
trap 'rm -f "$archive"' EXIT

[[ ! -e "$release_dir" ]] || { echo "Release already exists" >&2; exit 66; }
aws s3 cp --only-show-errors "$s3_uri" "$archive"
printf '%s  %s\n' "$expected_sha" "$archive" | sha256sum -c -
install -d -o coursistant -g coursistant -m 0750 "$release_dir"
tar --extract --gzip --file "$archive" --directory "$release_dir" --no-same-owner
chown -R coursistant:coursistant "$release_dir"
[[ -f "$release_dir/index.html" ]] || { rm -rf --one-file-system "$release_dir"; echo "Missing index.html" >&2; exit 67; }

[[ -z "$previous_target" ]] || ln -sfn "$previous_target" "$release_root/previous"
rm -f "$release_root/current.next"
ln -s "$release_dir" "$release_root/current.next"
mv -Tf "$release_root/current.next" "$release_root/current"

if ! nginx -t; then
  [[ -z "$previous_target" ]] || ln -sfn "$previous_target" "$release_root/current"
  exit 68
fi
systemctl reload nginx
echo "Frontend release active: $release_id"
SCRIPT
chmod 0750 /usr/local/bin/coursistant-deploy-frontend

cat > /etc/nginx/conf.d/coursistant.conf <<'NGINX'
server {
  listen 8080 default_server;
  server_name _;
  root /opt/coursistant/frontend/current;
  client_max_body_size 50m;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location = /infra-health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok","component":"edge"}';
  }

  location /api/ {
    proxy_pass http://127.0.0.1:${lms_api_port};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 120s;
  }

  location /ai-agent/ {
    proxy_pass http://127.0.0.1:${ai_agent_port}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
  }

  location /study-support/ {
    proxy_pass http://127.0.0.1:${study_support_port}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
NGINX
rm -f /etc/nginx/conf.d/default.conf

if command -v setsebool >/dev/null 2>&1; then
  setsebool -P httpd_can_network_connect 1 || true
fi

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CLOUDWATCH'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "${nginx_log_group}",
            "log_stream_name": "{instance_id}/access",
            "retention_in_days": 365
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "${nginx_log_group}",
            "log_stream_name": "{instance_id}/error",
            "retention_in_days": 365
          },
          {
            "file_path": "/var/log/coursistant/*.log",
            "log_group_name": "${application_log_group}",
            "log_stream_name": "{instance_id}/application",
            "retention_in_days": 365
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      }
    }
  }
}
CLOUDWATCH

nginx -t
systemctl enable --now nginx
systemctl enable --now amazon-ssm-agent
systemctl daemon-reload
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
